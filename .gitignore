# ---------- Personal local scripts ----------
/run.py

# ---------- Secrets ----------
.env
.env.*
!.env.example

# ---------- Python (backend) ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# App data (hidden JSON storage: chats, memory). Never commit user data.
backend/data/*
!backend/data/.gitkeep

# ---------- Node / Angular (frontend) ----------
# frontend/.gitignore covers node_modules, dist, .angular cache, etc.

# ---------- OS / editors ----------
.DS_Store
Thumbs.db
.idea/
*.log
