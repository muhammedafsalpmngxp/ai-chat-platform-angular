# Copy this file to backend/.env and fill in the values.
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# Never commit backend/.env - it is git-ignored.

# --- App ---
APP_NAME=AI Chatbot
ENVIRONMENT=development
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:4200

# --- Login (single user for now) ---
APP_USERNAME=admin
APP_DISPLAY_NAME=Admin
# Generate with: python scripts/hash_password.py --secret
# Keep the single quotes: bcrypt hashes contain '$' characters.
APP_PASSWORD_HASH=''

# --- JWT ---
# Random string, at least 32 characters (also printed by scripts/hash_password.py --secret)
JWT_SECRET=''
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Premium models / password safety ---
# How long re-entering the password unlocks premium models
PREMIUM_UNLOCK_MINUTES=30
# Wrong passwords (login or re-check) before a short lockout
MAX_PASSWORD_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=5

# --- Storage ---
# json   = hidden JSON files in DATA_DIR (survives restarts)
# memory = in-process only (lost on restart)
STORAGE_BACKEND=json
DATA_DIR=data

# --- External APIs ---
# Required for chat replies (phase 2+)
OPENAI_API_KEY=
# Required for web search (phase 4+)
TAVILY_API_KEY=

# --- Assistant / LLM (optional, defaults shown) ---
ASSISTANT_NAME=AI Chatbot
# Cheap model for background jobs such as chat titles
UTILITY_MODEL=gpt-6-luna
MODERATION_MODEL=omni-moderation-latest
# Older messages beyond this (approximate) size are not sent to the model
HISTORY_MAX_TOKENS=60000
LLM_TIMEOUT_SECONDS=60
# Ask the utility model to route messages the quick rules can't decide
ROUTER_USE_LLM=true

# --- Web search ---
# Results per query; up to SEARCH_MAX_QUERIES queries run per question (duplicates merged)
SEARCH_MAX_RESULTS=6
SEARCH_MAX_QUERIES=2
# advanced = better passages (2 Tavily credits per query); basic = 1 credit
SEARCH_DEPTH=advanced
# Most sources passed to the evidence check and the answer writer
SEARCH_MAX_SOURCES=8
# Compare all sources with the utility model before answering (more trustworthy)
SEARCH_VERIFY=true

# --- Ask Data (company data agent on an existing server; used as-is) ---
# Leave empty to turn Ask Data off. Users connect their company account in Settings.
# Auth service base URL (POST /auth/login, /auth/refresh-token)
ASK_DATA_AUTH_URL=
# Tenant API base URL including /api (POST /ai/ask, streams SSE)
ASK_DATA_API_URL=
# Tells the router which questions belong to Ask Data
#ASK_DATA_DESCRIPTION=the company's own business data (wells, plants, production, ...)
ASK_DATA_TIMEOUT_SECONDS=180
ASK_DATA_MAX_ROWS=200

# --- Uploads (images + documents) ---
MAX_UPLOAD_MB=10
MAX_FILES_PER_CHAT=3
# Longest document text sent to the model per file (characters)
MAX_DOCUMENT_CHARS=60000
